---
import type { CollectionEntry } from 'astro:content';
import ArrowLink from './ArrowLink.astro';

interface Props {
  finding: CollectionEntry<'findings'>;
  year?: number;
  observations: Array<{ title: string; href: string }>;
}
const { finding, year, observations } = Astro.props;
---
<article class="finding-summary">
  {year && <p class="finding-year">{year}</p>}
  <p class="record-kicker">{finding.data.demo ? 'Demonstration finding' : 'Research finding'}</p>
  <h3>{finding.data.title}</h3>
  <p class="finding-statement">{finding.data.summary}</p>
  {observations.length > 0 && <div class="finding-links">
    {observations.map((observation) => <ArrowLink href={observation.href} label={`Open the connected observation: ${observation.title}`} />)}
  </div>}
</article>
