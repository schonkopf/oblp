---
import type { CollectionEntry } from 'astro:content';

interface Props {
  datasets: CollectionEntry<'resources'>[];
}

const { datasets } = Astro.props;
---

<section class="station-section shell" aria-labelledby="data-heading">
  <div class="station-section__heading">
    <p class="eyebrow">Associated datasets</p>
    <h2 id="data-heading" class="visually-hidden">Associated datasets</h2>
  </div>
  {datasets.length > 0 ? (
    <div class="station-resource-list">
      {datasets.map(({ data }) => (
        <article>
          <div>
            {data.repository && <p class="record-kicker">{data.repository}</p>}
            <h3>{data.title}</h3>
            <p>{data.description ?? data.summary}</p>
          </div>
          {data.url && <a class="button" href={data.url} target="_blank" rel="noopener">Access on {data.repository ?? 'external site'} <span aria-hidden="true">↗</span></a>}
        </article>
      ))}
    </div>
  ) : <p class="dataset-empty">Coming soon.</p>}
</section>
