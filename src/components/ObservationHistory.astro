---
interface DepthRange {
  min: number;
  max: number;
}

interface Observation {
  id: string;
  title: string;
  kind: 'station' | 'survey';
  region: string;
  startDate: Date | string;
  url: string;
  depthM?: number;
  depthRangeM?: DepthRange;
}

interface Props { observations: Observation[]; }

const { observations } = Astro.props;
const start = Date.UTC(2000, 0, 1);
const now = Date.now();
const span = Math.max(1, now - start);
const usableDepth = (depth: unknown): depth is number => typeof depth === 'number' && Number.isFinite(depth) && depth >= 0;

const points = observations
  .map((observation) => {
    const date = new Date(observation.startDate);
    const range = observation.kind === 'survey' && observation.depthRangeM
      && usableDepth(observation.depthRangeM.min) && usableDepth(observation.depthRangeM.max)
      ? observation.depthRangeM
      : undefined;
    const singleDepth = observation.kind === 'station' && usableDepth(observation.depthM) ? observation.depthM : undefined;
    const representativeDepth = range ? (range.min + range.max) / 2 : singleDepth;
    const depthText = range
      ? `Depth range: ${range.min}–${range.max} m`
      : singleDepth !== undefined ? `Depth: ${singleDepth} m` : 'Depth not specified';
    return { ...observation, date, timestamp: date.getTime(), representativeDepth, depthText };
  })
  .filter(({ timestamp }) => Number.isFinite(timestamp) && timestamp >= start && timestamp <= now)
  .sort((a, b) => {
    if (a.representativeDepth === undefined && b.representativeDepth !== undefined) return 1;
    if (a.representativeDepth !== undefined && b.representativeDepth === undefined) return -1;
    if (a.representativeDepth !== undefined && b.representativeDepth !== undefined) {
      const depthDifference = a.representativeDepth - b.representativeDepth;
      if (depthDifference !== 0) return depthDifference;
    }
    return a.timestamp - b.timestamp || a.title.localeCompare(b.title) || a.id.localeCompare(b.id);
  })
  .map((observation, lane) => {
    const position = ((observation.timestamp - start) / span) * 100;
    return { ...observation, position, lane };
  });

const firstUnspecifiedLane = points.findIndex(({ representativeDepth }) => representativeDepth === undefined);
const currentYear = new Date(now).getUTCFullYear();
const tickYears = [2000, 2005, 2010, 2015, 2020, 2025].filter((year) => year < currentYear);
const ticks = [
  ...tickYears.map((year) => ({ label: String(year), position: ((Date.UTC(year, 0, 1) - start) / span) * 100 })),
  { label: 'Now', position: 100 },
];
const formatDate = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<section class="observation-history shell" aria-labelledby="observation-history-heading">
  <div class="observation-history__heading">
    <div>
      <p class="eyebrow">Observation history</p>
      <h2 id="observation-history-heading" class="visually-hidden">Observation history ordered by depth</h2>
    </div>
    <ul class="observation-history__legend" aria-label="Observation symbol legend">
      <li><span class="history-key history-key--station" aria-hidden="true"></span>Station</li>
      <li><span class="history-key history-key--survey" aria-hidden="true"></span>Survey</li>
    </ul>
  </div>

  <div class="observation-history__viewport" tabindex="0" aria-label="Observation history from 2000 to now; records are ordered from shallow to deep in separate lanes; scroll horizontally on narrow screens">
    <div class="observation-history__plot" style={`--lane-count: ${points.length}`}>
      <div class="observation-history__ticks" aria-hidden="true">
        {ticks.map((tick) => <div class="history-tick" style={`--position: ${tick.position}%`}><span>{tick.label}</span></div>)}
      </div>
      <div class="observation-history__time-axis" aria-hidden="true"></div>
      <div class="observation-history__depth-axis" aria-hidden="true"><span>Depth</span><b>↓</b></div>
      <div class="observation-history__lanes">
        {firstUnspecifiedLane >= 0 && <div class="observation-history__unspecified-divider" style={`--lane: ${firstUnspecifiedLane}`} aria-hidden="true"><span>Depth not specified</span></div>}
        {points.map((point) => (
          <a
            class={`history-marker history-marker--${point.kind}`}
            href={point.url}
            style={`--position: ${point.position}%; --lane: ${point.lane}`}
            data-history-marker={point.lane}
            aria-describedby={`history-tooltip-${point.lane}`}
            aria-label={`${point.title}, ${point.kind === 'station' ? 'long-term monitoring station' : 'spatial survey'}, ${point.region}, ${point.depthText}, ${point.kind === 'station' ? 'since' : 'started'} ${formatDate.format(point.date)}`}
          >
            <span class="history-marker__glyph" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="observation-history__tooltip-layer">
    {points.map((point) => (
      <span id={`history-tooltip-${point.lane}`} class="history-tooltip" data-history-tooltip={point.lane} role="tooltip" hidden>
        <strong>{point.title}</strong>
        <span>{point.kind === 'station' ? 'Long-term monitoring station' : 'Spatial survey'} · {point.region}</span>
        <span>{point.depthText}</span>
        <time datetime={point.date.toISOString().slice(0, 10)}>{point.kind === 'station' ? 'Since' : 'Started'} {formatDate.format(point.date)}</time>
        <b>View {point.kind} →</b>
      </span>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.observation-history').forEach((history) => {
    const markers = history.querySelectorAll<HTMLElement>('[data-history-marker]');
    let activeMarker: HTMLElement | null = null;
    let activeTooltip: HTMLElement | null = null;
    const offset = 10;
    const pageInset = 8;

    const placeTooltip = () => {
      if (!activeMarker || !activeTooltip) return;
      const marker = activeMarker.getBoundingClientRect();
      const tooltip = activeTooltip.getBoundingClientRect();
      const section = history.getBoundingClientRect();
      const topBound = Math.max(pageInset, section.top);
      const bottomBound = Math.min(window.innerHeight - pageInset, section.bottom);
      const leftBound = Math.max(pageInset, section.left);
      const rightBound = Math.min(window.innerWidth - pageInset, section.right);
      const markerY = marker.top + marker.height / 2;
      const opensAbove = markerY > topBound + (bottomBound - topBound) / 2;
      const opensLeft = rightBound - marker.right < tooltip.width + offset;
      const preferredTop = opensAbove ? marker.top - tooltip.height - offset : marker.bottom + offset;
      const preferredLeft = opensLeft ? marker.left - tooltip.width - offset : marker.right + offset;

      activeTooltip.classList.toggle('history-tooltip--above', opensAbove);
      activeTooltip.classList.toggle('history-tooltip--left', opensLeft);
      activeTooltip.style.top = `${Math.min(Math.max(preferredTop, topBound), bottomBound - tooltip.height)}px`;
      activeTooltip.style.left = `${Math.min(Math.max(preferredLeft, leftBound), rightBound - tooltip.width)}px`;
      activeTooltip.style.visibility = 'visible';
    };

    const showTooltip = (marker: HTMLElement) => {
      const key = marker.dataset.historyMarker;
      const tooltip = key === undefined ? null : history.querySelector<HTMLElement>(`[data-history-tooltip="${key}"]`);
      if (!tooltip) return;
      if (activeTooltip && activeTooltip !== tooltip) activeTooltip.hidden = true;
      activeMarker = marker;
      activeTooltip = tooltip;
      tooltip.style.visibility = 'hidden';
      tooltip.hidden = false;
      placeTooltip();
    };

    const hideTooltip = (marker: HTMLElement) => {
      if (activeMarker !== marker || !activeTooltip) return;
      activeTooltip.hidden = true;
      activeMarker = null;
      activeTooltip = null;
    };

    markers.forEach((marker) => {
      marker.addEventListener('mouseenter', () => showTooltip(marker));
      marker.addEventListener('mouseleave', () => hideTooltip(marker));
      marker.addEventListener('focus', () => showTooltip(marker));
      marker.addEventListener('blur', () => hideTooltip(marker));
    });
    history.querySelector('.observation-history__viewport')?.addEventListener('scroll', placeTooltip, { passive: true });
    window.addEventListener('scroll', placeTooltip, { passive: true });
    window.addEventListener('resize', placeTooltip, { passive: true });
  });
</script>

<style>
  .observation-history { padding-block: var(--space-6); border-bottom: 1px solid var(--color-line); }
  .observation-history__heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .observation-history__heading .eyebrow { margin: 0; }
  .observation-history__legend { display: flex; gap: var(--space-3); margin: 0; padding: 0; color: var(--color-muted); font-size: .72rem; list-style: none; }
  .observation-history__legend li { display: flex; align-items: center; gap: .4rem; }
  .history-key { display: inline-block; width: .65rem; height: .65rem; border: 1.5px solid var(--color-teal-600); }
  .history-key--station { border-color: var(--color-ocean-800); border-radius: 50%; background: var(--color-ocean-800); }
  .history-key--survey { background: #fff; }
  .observation-history__viewport { max-width: 100%; margin-top: var(--space-4); overflow-x: auto; overflow-y: hidden; scrollbar-width: thin; }
  .observation-history__viewport:focus-visible { outline: 3px solid var(--color-signal); outline-offset: 3px; }
  .observation-history__plot { position: relative; min-width: 48rem; height: max(13rem, calc(8.25rem + var(--lane-count) * 2.25rem)); margin-inline: 2rem .45rem; }
  .observation-history__ticks { position: absolute; inset: 0; }
  .history-tick { position: absolute; left: var(--position); height: 100%; border-left: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent); }
  .history-tick:first-child span { transform: none; }
  .history-tick:last-child span { transform: translateX(-100%); }
  .history-tick span { position: absolute; top: 0; transform: translateX(-50%); color: var(--color-muted); font-size: .66rem; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .observation-history__time-axis { position: absolute; top: 2rem; right: 0; left: 0; height: 1px; background: var(--color-ocean-800); }
  .observation-history__depth-axis { position: absolute; top: 3.2rem; bottom: 4rem; left: -1.65rem; display: flex; align-items: center; flex-direction: column; color: var(--color-muted); font-size: .6rem; letter-spacing: .13em; text-transform: uppercase; }
  .observation-history__depth-axis span { position: absolute; top: 50%; transform: translateY(-50%) rotate(-90deg); }
  .observation-history__depth-axis b { margin-top: auto; font-size: .8rem; font-weight: 400; }
  .observation-history__lanes { position: absolute; top: 3.2rem; right: 0; left: 0; }
  .history-marker { position: absolute; z-index: 1; top: calc(var(--lane) * 2.25rem); left: var(--position); display: grid; width: 1.35rem; height: 1.35rem; place-items: center; transform: translateX(-50%); color: inherit; text-decoration: none; }
  .history-marker__glyph { width: .65rem; height: .65rem; border: 1.5px solid var(--color-teal-600); background: #fff; transition: transform .15s ease, box-shadow .15s ease; }
  .history-marker--station .history-marker__glyph { border-color: var(--color-ocean-800); border-radius: 50%; background: var(--color-ocean-800); }
  .history-marker__label { position: absolute; left: 1.15rem; width: 10rem; color: var(--color-muted); font-size: .62rem; line-height: 1.2; pointer-events: none; }
  .history-marker:nth-of-type(even) .history-marker__label { right: 1.15rem; left: auto; text-align: right; }
  .history-marker:hover, .history-marker:focus-visible { z-index: 5; outline: none; }
  .history-marker:hover .history-marker__glyph, .history-marker:focus-visible .history-marker__glyph { transform: scale(1.35); box-shadow: 0 0 0 3px #fff, 0 0 0 4px var(--color-signal); }
  .observation-history__tooltip-layer { position: fixed; z-index: 20; inset: 0; overflow: visible; pointer-events: none; }
  .history-tooltip { position: fixed; display: grid; width: 14.5rem; padding: .7rem .8rem; gap: .15rem; border: 1px solid var(--color-line); background: #fff; box-shadow: 0 7px 22px rgba(4,31,45,.13); color: var(--color-muted); font-size: .7rem; line-height: 1.45; }
  .history-tooltip strong { color: var(--color-ink); font-family: var(--font-serif); font-size: .9rem; font-weight: 600; }
  .history-tooltip b { margin-top: .2rem; color: var(--color-teal-600); font-size: .68rem; }
  .observation-history__unspecified-divider { position: absolute; top: calc(var(--lane) * 2.25rem - .45rem); right: 0; left: 0; border-top: 1px solid var(--color-line); }
  .observation-history__unspecified-divider span { position: absolute; top: -.85rem; left: 0; padding-right: .4rem; background: #fff; color: var(--color-muted); font-size: .55rem; letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 760px) {
    .observation-history { padding-block: var(--space-5); }
    .observation-history__heading { align-items: flex-start; flex-direction: column; gap: .7rem; }
    .observation-history__viewport { margin-right: -1rem; padding-right: 1rem; }
  }
</style>
