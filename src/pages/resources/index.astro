---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/urls';

const publications = await getCollection('publications', ({ data }) => data.status === 'published' && !data.demo);
const reusableResources = await getCollection('resources', ({ data }) =>
  data.status === 'published' && !data.demo && ['dataset', 'software', 'tutorial'].includes(data.resourceType),
);
const page = await getEntry('pages', 'resources');
if (!page || page.data.pageType !== 'resources') throw new Error('Missing or invalid pages/resources content entry.');

const resourceLabels = { publication: 'Publication', dataset: 'Dataset', software: 'Software', tutorial: 'Tutorial' } as const;
const records = [
  ...publications.map(({ id, data }) => ({
    id,
    kind: 'publication' as const,
    title: data.title,
    summary: data.summary,
    year: data.year,
    authors: data.authors,
    metadata: data.journal ?? data.venue ?? 'Scientific publication',
    citation: data.citation,
    repository: undefined,
    license: undefined,
    access: undefined,
    href: data.doi ?? data.url,
    action: data.doi ? 'View DOI' : 'Open publication',
  })),
  ...reusableResources.map(({ id, data }) => ({
    id,
    kind: data.resourceType as 'dataset' | 'software' | 'tutorial',
    title: data.title,
    summary: data.summary,
    year: undefined,
    authors: undefined,
    metadata: data.repository ?? data.license ?? 'Reusable resource',
    citation: data.citation,
    repository: data.repository,
    license: data.license,
    access: data.accessConditions,
    href: data.url ?? (data.file ? withBase(data.file) : undefined),
    action: data.url ? (data.resourceType === 'software' ? 'Open repository' : `Open ${data.resourceType}`) : data.file ? 'Download resource' : undefined,
  })),
].sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || a.title.localeCompare(b.title));

const categories = [
  { id: 'publication', label: 'Publications' },
  { id: 'dataset', label: 'Datasets' },
  { id: 'software', label: 'Software' },
  { id: 'tutorial', label: 'Tutorials' },
] as const;
const counts = Object.fromEntries(categories.map(({ id }) => [id, records.filter((record) => record.kind === id).length]));
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="page-hero page-hero--dark"><div class="shell"><p class="eyebrow">{page.data.eyebrow}</p><h1>{page.data.heroTitle}</h1><p class="lede">{page.data.heroText}</p></div></section>

  <section class="resource-catalogue shell" data-resource-catalogue>
    <h2 class="visually-hidden">Resource catalogue</h2>
    <dl class="resource-stats" aria-label="Published resources by type">
      {categories.map(({ id, label }) => <div><dt>{label}</dt><dd>{String(counts[id]).padStart(2, '0')}</dd></div>)}
    </dl>

    <div class="resource-controls" aria-label="Filter resources">
      <label class="search-field"><span>Search resources</span><input type="search" name="query" placeholder="Search titles, authors, citations, or repositories" /></label>
      <label><span>Type</span><select name="type"><option value="">All types</option>{categories.map(({ id, label }) => <option value={id}>{label}</option>)}</select></label>
      <button class="reset-button" type="button">Reset</button>
    </div>
    <p class="results-status" aria-live="polite">Showing {records.length} of {records.length} resources</p>
    <div class="resource-results">
      {records.map((record) => {
        const searchable = [record.title, record.summary, record.authors?.join(' '), record.year, resourceLabels[record.kind], record.metadata, record.citation, record.repository].filter(Boolean).join(' ').toLocaleLowerCase();
        return <article class="resource-result" data-resource data-kind={record.kind} data-search={searchable}>
          <div class="resource-result__meta"><span>{resourceLabels[record.kind]}</span>{record.year && <span>{record.year}</span>}</div>
          <h3>{record.title}</h3>
          {record.authors && <p class="resource-result__authors">{record.authors.join(', ')}</p>}
          <p class="resource-result__summary">{record.summary}</p>
          <dl class="resource-result__details">
            {record.metadata && <div><dt>Source</dt><dd>{record.metadata}</dd></div>}
            {record.license && <div><dt>License</dt><dd>{record.license}</dd></div>}
            {record.citation && <div><dt>Citation</dt><dd>{record.citation}</dd></div>}
            {record.access && <div><dt>Access</dt><dd>{record.access}</dd></div>}
          </dl>
          {record.href && record.action && <a class="arrow-link" href={record.href}>{record.action} <span aria-hidden="true">↗</span><span class="visually-hidden">: {record.title}</span></a>}
        </article>;
      })}
      <p class="empty-state no-results" hidden>No resources match these filters. Try broadening your search.</p>
    </div>
  </section>

  <script>
    const catalogue = document.querySelector<HTMLElement>('[data-resource-catalogue]');
    if (catalogue) {
      const queryInput = catalogue.querySelector<HTMLInputElement>('input[name="query"]');
      const typeSelect = catalogue.querySelector<HTMLSelectElement>('select[name="type"]');
      const reset = catalogue.querySelector<HTMLButtonElement>('.reset-button');
      const status = catalogue.querySelector<HTMLElement>('.results-status');
      const noResults = catalogue.querySelector<HTMLElement>('.no-results');
      const items = [...catalogue.querySelectorAll<HTMLElement>('[data-resource]')];
      const update = () => {
        const query = queryInput?.value.trim().toLocaleLowerCase() ?? '';
        const type = typeSelect?.value ?? '';
        let visible = 0;
        items.forEach((item) => {
          const matches = (!query || item.dataset.search?.includes(query)) && (!type || item.dataset.kind === type);
          item.hidden = !matches;
          if (matches) visible += 1;
        });
        if (status) status.textContent = `Showing ${visible} of ${items.length} resources`;
        if (noResults) noResults.hidden = visible !== 0;
      };
      queryInput?.addEventListener('input', update);
      typeSelect?.addEventListener('change', update);
      reset?.addEventListener('click', () => {
        if (queryInput) queryInput.value = '';
        if (typeSelect) typeSelect.value = '';
        update();
        queryInput?.focus();
      });
    }
  </script>
</BaseLayout>
