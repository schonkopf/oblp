---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import InteractiveEmbed from '../../components/InteractiveEmbed.astro';
import { surveyUrl, withBase } from '../../utils/urls';

export async function getStaticPaths() {
  const entries = await getCollection('stations', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'stations'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const region = await getEntry(entry.data.region);

const [allSurveys, allAudio, allVisualizations, allResources, allFindings, allPublications, allPartners] = await Promise.all([
  getCollection('surveys', ({ data }) => data.status === 'published'),
  getCollection('audio', ({ data }) => data.status === 'published'),
  getCollection('visualizations', ({ data }) => data.status === 'published'),
  getCollection('resources', ({ data }) => data.status === 'published'),
  getCollection('findings', ({ data }) => data.status === 'published'),
  getCollection('publications', ({ data }) => data.status === 'published'),
  getCollection('partners', ({ data }) => data.status === 'published'),
]);

const surveys = allSurveys.filter(({ data }) => data.stations.some(({ id }) => id === entry.id));
const audio = allAudio.filter(({ data }) => data.station?.id === entry.id);
const visualizations = allVisualizations.filter(({ data }) => data.station?.id === entry.id);
const resources = allResources.filter(({ data }) => data.resourceType === 'dataset' && data.stations.some(({ id }) => id === entry.id));
const findings = allFindings.filter(({ data }) => data.stations.some(({ id }) => id === entry.id));
const publications = allPublications.filter(({ data }) => data.relatedStations.some(({ id }) => id === entry.id));
const partners = allPartners.filter(({ id }) => entry.data.partners.some((reference) => reference.id === id));
const spectrograms = visualizations.filter(({ data }) => data.visualizationType === 'long-term-spectrogram');
const habitatVisualizations = visualizations.filter(({ data }) => data.visualizationType === 'photogrammetry');
const otherVisualizations = visualizations.filter(({ data }) => !['long-term-spectrogram', 'photogrammetry'].includes(data.visualizationType));
const hasRelatedEvidence = surveys.length + findings.length + publications.length + otherVisualizations.length > 0;

const formatDate = (date: Date) => new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(date);
const formatTerm = (value: string) => value === 'eDNA' ? value : value.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const statusLabel = entry.data.operationalStatus ? formatTerm(entry.data.operationalStatus) : undefined;
const aboutText = entry.data.description;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <header class="station-hero">
    <div class="shell station-hero__layout">
      <div>
        <p class="eyebrow">{formatTerm(entry.data.stationType)} monitoring station</p>
        <h1>{entry.data.title}</h1>
        <p class="station-location">{region?.data.title}{entry.data.ecosystem && <> · {entry.data.ecosystem}</>}</p>
        <p class="lede">{entry.data.summary}</p>
      </div>
      <dl class="station-vitals" aria-label="Key station facts">
        {entry.data.depthM !== undefined && <div><dt>Observation depth</dt><dd>{entry.data.depthM} m</dd></div>}
        {statusLabel && <div><dt>Monitoring status</dt><dd>{statusLabel}</dd></div>}
        {entry.data.monitoringSince && <div><dt>Monitoring since</dt><dd>{formatDate(entry.data.monitoringSince)}</dd></div>}
      </dl>
    </div>
  </header>

  <section class="station-section shell" aria-labelledby="about-heading">
    {entry.data.demo && <DemoNotice />}
    <div class="station-section__heading">
      <p class="eyebrow">Field context</p>
      <h2 id="about-heading" class="visually-hidden">Field context</h2>
    </div>
    <div class="station-about">
      <div class="station-narrative">
        {aboutText && <p class="station-description">{aboutText}</p>}
        <div class="prose"><Content /></div>
      </div>
      <dl class="station-metadata">
        {entry.data.coordinates && <div><dt>Coordinates</dt><dd>{entry.data.coordinates.latitude.toFixed(3)}°, {entry.data.coordinates.longitude.toFixed(3)}°</dd></div>}
        {entry.data.habitat && <div><dt>Habitat</dt><dd>{entry.data.habitat}</dd></div>}
        {entry.data.marineProtectedArea !== undefined && <div><dt>Marine protected area</dt><dd>{entry.data.marineProtectedArea ? 'Within a protected area' : 'No'}</dd></div>}
        {entry.data.observationTypes.length > 0 && <div><dt>Observations</dt><dd>{entry.data.observationTypes.map(formatTerm).join(' · ')}</dd></div>}
        {entry.data.instrumentation.length > 0 && <div><dt>Instrumentation</dt><dd>{entry.data.instrumentation.join(' · ')}</dd></div>}
        {entry.data.deploymentConfiguration && <div><dt>Deployment</dt><dd>{entry.data.deploymentConfiguration}{entry.data.heightAboveSeafloorM !== undefined && ` · ${entry.data.heightAboveSeafloorM} m above seafloor`}</dd></div>}
        {entry.data.monitoringPeriod && <div><dt>Monitoring period</dt><dd>{entry.data.monitoringPeriod}</dd></div>}
        {entry.data.methods.length > 0 && <div><dt>Methods</dt><dd>{entry.data.methods.join(' · ')}</dd></div>}
      </dl>
    </div>
    {entry.data.media && <figure class="station-field-image">
      <img src={withBase(entry.data.media.src)} alt={entry.data.media.alt} loading="lazy" />
      {(entry.data.media.caption || entry.data.media.credit) && <figcaption>{entry.data.media.caption}{entry.data.media.caption && entry.data.media.credit && ' '}{entry.data.media.credit && <span>Credit: {entry.data.media.credit}</span>}</figcaption>}
    </figure>}
  </section>

  {audio.length > 0 && <section class="station-section station-section--tint" aria-labelledby="listen-heading"><div class="shell">
    <div class="station-section__heading"><p class="eyebrow">Example audio</p><h2 id="listen-heading" class="visually-hidden">Example audio</h2></div>
    <div class="audio-list">
      {audio.map(({ data }) => <article class="audio-observation">
        <div><p class="record-kicker">{data.audioType ? formatTerm(data.audioType) : 'Audio observation'}</p><h3>{data.title}</h3><p>{data.recordingContext ?? data.summary}</p></div>
        <div class="audio-playback">
          {data.file && <audio controls preload="none" src={withBase(data.file)} aria-label={`Play ${data.title}`}>Your browser does not support HTML audio. <a href={withBase(data.file)}>Download the recording</a>.</audio>}
          {data.listenFor.length > 0 && <div class="listen-for"><h4>Listen for</h4><ul>{data.listenFor.map((note) => <li>{note}</li>)}</ul></div>}
        </div>
      </article>)}
    </div>
  </div></section>}

  {spectrograms.length > 0 && <section class="station-section station-media-section" aria-labelledby="soundscape-heading"><div class="shell">
    <div class="station-section__heading station-section__heading--wide"><p class="eyebrow">Temporal observation</p><h2 id="soundscape-heading" class="visually-hidden">Temporal observation</h2></div>
    {spectrograms.map(({ data }) => <article class="visualization-record">
      <div class="visualization-intro"><div><h3>{data.title}</h3><p>{data.description ?? data.summary}</p></div>{data.interpretation && <aside><h4>Interpretation</h4><p>{data.interpretation}</p></aside>}</div>
      {data.src && data.format === 'interactive-html' && <InteractiveEmbed src={data.src} title={data.title} />}
    </article>)}
  </div></section>}

  {habitatVisualizations.length > 0 && <section class="station-section station-section--dark station-media-section" aria-labelledby="habitat-heading"><div class="shell">
    <div class="station-section__heading station-section__heading--wide"><p class="eyebrow">Explore the habitat</p><h2 id="habitat-heading" class="visually-hidden">Explore the habitat</h2></div>
    {habitatVisualizations.map(({ data }) => <article class="visualization-record"><div class="visualization-intro"><div><h3>{data.title}</h3><p>{data.description ?? data.summary}</p></div>{data.interpretation && <aside><h4>Interpretation</h4><p>{data.interpretation}</p></aside>}</div>{data.src && data.format === 'interactive-html' && <InteractiveEmbed src={data.src} title={data.title} />}</article>)}
  </div></section>}

  {resources.length > 0 && <section class="station-section shell" aria-labelledby="data-heading">
    <div class="station-section__heading"><p class="eyebrow">Associated datasets</p><h2 id="data-heading" class="visually-hidden">Associated datasets</h2></div>
    <div class="station-resource-list">{resources.map(({ data }) => <article><div><p class="record-kicker">{formatTerm(data.resourceType)}{data.repository && ` · ${data.repository}`}</p><h3>{data.title}</h3><p>{data.description ?? data.summary}</p></div>{data.url && <a class="button" href={data.url} target="_blank" rel="noopener">Access on {data.repository ?? 'external site'} <span aria-hidden="true">↗</span></a>}</article>)}</div>
  </section>}

  {hasRelatedEvidence && <section class="station-section station-section--tint" aria-labelledby="evidence-heading"><div class="shell">
    <div class="station-section__heading"><p class="eyebrow">Connected records</p><h2 id="evidence-heading">Related evidence</h2></div>
    <div class="evidence-records">
      {surveys.map(({ id, data }) => <article><p class="record-kicker">Survey</p><h3><a href={surveyUrl(id)}>{data.title}</a></h3><p>{data.summary}</p></article>)}
      {findings.map(({ data }) => <article><p class="record-kicker">Finding</p><h3>{data.title}</h3><p>{data.summary}</p></article>)}
      {publications.map(({ data }) => <article><p class="record-kicker">Publication · {data.year}</p><h3>{data.url || data.doi ? <a href={data.url ?? data.doi} target="_blank" rel="noopener">{data.title} <span aria-hidden="true">↗</span></a> : data.title}</h3><p>{data.authors.join(', ')}</p></article>)}
      {otherVisualizations.map(({ data }) => <article><p class="record-kicker">Visualization</p><h3>{data.title}</h3><p>{data.description ?? data.summary}</p></article>)}
    </div>
  </div></section>}
  {partners.length > 0 && <section class="station-section station-section--dark" aria-labelledby="partners-heading"><div class="shell">
    <div class="station-section__heading"><p class="eyebrow">Partners</p><h2 id="partners-heading" class="visually-hidden">Partners</h2></div>
    <div class="partner-list">{partners.map(({ data }) => <article>
      <p class="card-type">{formatTerm(data.partnerType)}</p>
      <h3>{data.url ? <a href={data.url} target="_blank" rel="noopener">{data.name} <span aria-hidden="true">↗</span></a> : data.name}</h3>
      <p>{data.summary}</p>
    </article>)}</div>
  </div></section>}
</BaseLayout>
