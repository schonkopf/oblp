---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import { surveyUrl, withBase } from '../../utils/urls';

export async function getStaticPaths() {
  const entries = await getCollection('stations', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'stations'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const region = await getEntry(entry.data.region);
const surveys = (await getCollection('surveys', ({ data }) => data.status === 'published')).filter((survey) => survey.data.stations.some((station) => station.id === entry.id));
const audio = (await getCollection('audio', ({ data }) => data.status === 'published')).filter((item) => item.data.station?.id === entry.id);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <header class="detail-hero"><div class="shell"><p class="eyebrow">{entry.data.stationType} station</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.summary}</p></div></header>
  <div class="detail-grid shell">
    <article class="detail-content">
      {entry.data.demo && <DemoNotice />}
      <div class="prose"><Content /></div>
      <h2>Methods</h2>
      {entry.data.methods.length ? <ul class="tag-list">{entry.data.methods.map((method) => <li>{method}</li>)}</ul> : <p class="empty-state">Methods have not been provided.</p>}
      <h2>Connected records</h2>
      {surveys.length ? <div class="record-list">{surveys.map((survey) => <article class="record"><p class="record-meta">Survey</p><div><h2>{survey.data.title}</h2><p>{survey.data.summary}</p></div><ArrowLink href={surveyUrl(survey.id)} label="Open" /></article>)}</div> : <p class="empty-state">No published surveys are connected to this station.</p>}
      {audio.length > 0 && <p>{audio.length} published audio metadata record{audio.length === 1 ? '' : 's'} connected.</p>}
      <p><ArrowLink href={withBase('explore/')} label="Back to explore" /></p>
    </article>
    <aside class="metadata" aria-label="Station metadata">
      <p class="eyebrow">Station metadata</p>
      <dl>
        <div><dt>Stable ID</dt><dd>{entry.id}</dd></div>
        <div><dt>Region</dt><dd>{region?.data.title ?? 'Not provided'}</dd></div>
        <div><dt>Habitat</dt><dd>{entry.data.habitat ?? 'Not provided'}</dd></div>
        <div><dt>Depth</dt><dd>{entry.data.depthM === undefined ? 'Not provided' : `${entry.data.depthM} m`}</dd></div>
        <div><dt>Coordinates</dt><dd>{entry.data.coordinates ? `${entry.data.coordinates.latitude}, ${entry.data.coordinates.longitude}` : 'Not published'}</dd></div>
        <div><dt>Monitoring</dt><dd>{entry.data.monitoringPeriod ?? 'Not provided'}</dd></div>
      </dl>
    </aside>
  </div>
</BaseLayout>
