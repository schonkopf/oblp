---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/urls';

const page = await getEntry('pages', 'about');
if (!page || page.data.pageType !== 'about') throw new Error('Missing or invalid pages/about content entry.');
const allPartners = await getCollection('partners', ({ data }) => data.status === 'published');
const internationalPartners = allPartners.filter(({ data }) => ['research', 'network', 'infrastructure', 'community'].includes(data.partnerType)).sort((a, b) => a.data.name.localeCompare(b.data.name));
const funders = [...new Map(
  allPartners
    .filter(({ data }) => data.partnerType === 'funder')
    .map((partner) => [partner.data.name.trim().toLocaleLowerCase(), partner]),
).values()].sort((a, b) => a.data.name.localeCompare(b.data.name));
const mediaUrl = (src: string) => /^(?:[a-z]+:)?\/\//i.test(src) || src.startsWith('data:') ? src : withBase(src);
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="about-hero">
    <div class="shell"><p class="eyebrow">{page.data.eyebrow}</p><h1>{page.data.heroTitle}</h1></div>
  </section>

  <section class="section shell" aria-labelledby="team-heading">
    <div class="team-composition">
      <div><p class="eyebrow">{page.data.team.eyebrow}</p><h2 id="team-heading">{page.data.team.title}</h2></div>
      <a class="arrow-link" href={page.data.team.action.href} target="_blank" rel="noopener">{page.data.team.action.label} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section partner-section" aria-labelledby="partners-heading"><div class="shell">
    <div class="section-heading"><p class="eyebrow">{page.data.partners.eyebrow}</p><h2 id="partners-heading">{page.data.partners.title}</h2></div>
    <div class="partner-list">{internationalPartners.map(({ data }) => <article class:list={{ 'partner-with-logo': data.logo }}>
      {data.logo && <img class="partner-logo" src={mediaUrl(data.logo.src)} alt={data.logo.alt} loading="lazy" />}
      <div><p class="card-type">{data.country ?? (data.partnerType === 'network' ? 'International network' : data.partnerType)}</p><h3>{data.url ? <a href={data.url} target="_blank" rel="noopener">{data.name} <span aria-hidden="true">↗</span></a> : data.name}</h3><p>{data.collaborationFocus ?? data.summary}</p></div>
    </article>)}</div>
  </div></section>

  <section class="section shell" id="collaborate" aria-labelledby="opportunities-heading">
    <div class="opportunities-layout">
      <div class="opportunities-heading"><p class="eyebrow">{page.data.opportunities.eyebrow}</p><h2 id="opportunities-heading">{page.data.opportunities.title}</h2></div>
      <div>
        <ol class="opportunity-pathway">{page.data.opportunities.items.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ol>
        <div class="collaboration-contact"><p>{page.data.contact.title}</p><a class="arrow-link" href={page.data.contact.action.href}>{page.data.contact.action.label} <span aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="funding-heading"><div class="shell funder-layout">
    <div class="section-heading"><p class="eyebrow">{page.data.funding.eyebrow}</p><h2 id="funding-heading">{page.data.funding.title}</h2></div>
    <div class="funder-register">{funders.map(({ data }) => <article class:list={{ 'funder-with-logo': data.logo }}>
      {data.logo && <img class="funder-logo" src={mediaUrl(data.logo.src)} alt={data.logo.alt} loading="lazy" />}
      <h3>{data.url ? <a href={data.url} target="_blank" rel="noopener">{data.name} <span aria-hidden="true">↗</span></a> : data.name}</h3>
    </article>)}</div>
  </div></section>
</BaseLayout>
