---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { withBase } from '../utils/urls';

const page = await getEntry('pages', 'home');
if (!page || page.data.pageType !== 'home') throw new Error('Missing or invalid pages/home content entry.');

const stations = await getCollection('stations', ({ data }) => data.status === 'published');
const surveys = await getCollection('surveys', ({ data }) => data.status === 'published');
const resources = await getCollection('resources', ({ data }) => data.status === 'published');
const partners = await getCollection('partners', ({ data }) => data.status === 'published' && data.partnerType !== 'funder');

const networkCounts = [
  { label: 'Stations', value: stations.length },
  { label: 'Surveys', value: surveys.length },
  { label: 'Resources', value: resources.length },
  { label: 'Partners', value: partners.length },
];
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">{page.data.eyebrow}</p>
        <h1>{page.data.heroTitle}</h1>
        <p class="lede">{page.data.heroText}</p>
        <div class="button-row">
          <a class="button light" href={withBase(page.data.primaryCta.href)}>{page.data.primaryCta.label}</a>
          <a class="button ghost" href={withBase(page.data.secondaryCta.href)}>{page.data.secondaryCta.label}</a>
        </div>
      </div>
      <figure class="hero-image">
        <img src={withBase('assets/images/pages/home/Header.jpg')} width="2048" height="1536" alt="Underwater acoustic observation for the Ocean Biodiversity Listening Project" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="network-section">
    <div class="shell">
      <div class="section-heading split-heading"><div><p class="eyebrow">{page.data.network.eyebrow}</p><h2>{page.data.network.title}</h2></div><p>{page.data.network.text}</p></div>
      <div class="network-composition">
        <figure class="network-image">
          <img src={withBase('assets/images/pages/home/Network.jpg')} width="2048" height="970" alt="Ocean Biodiversity Listening Project observation network" loading="lazy" />
        </figure>
        <div class="network-summary">
          <dl class="network-stats">
            {networkCounts.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value.toString().padStart(2, '0')}</dd></div>)}
          </dl>
          <ArrowLink href={withBase('explore/')} label={page.data.network.actionLabel} />
        </div>
      </div>
    </div>
  </section>

  <section class="section shell knowledge-section">
    <div class="knowledge-intro"><p class="eyebrow">{page.data.pathway.eyebrow}</p><h2>{page.data.pathway.title}</h2><p>{page.data.pathway.text}</p></div>
    <ol class="knowledge-pathway">
      {page.data.pathway.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
    </ol>
  </section>

  <section class="evidence-section">
    <div class="shell evidence-grid">
      <figure class="research-concept">
        <svg viewBox="0 0 640 520" role="img" aria-labelledby="research-concept-title research-concept-description">
          <title id="research-concept-title">Interacting research domains</title>
          <desc id="research-concept-description">Biodiversity, soundscape, and the ocean environment form a connected triangular system.</desc>
          <g class="concept-connections" aria-hidden="true"><path d="M320 152 L174 356 L466 356 Z" /></g>
          <g class="concept-domains">
            <circle cx="320" cy="130" r="92" /><circle cx="155" cy="382" r="92" /><circle cx="485" cy="382" r="92" />
          </g>
          <g class="concept-labels">
            <text x="320" y="136">Biodiversity</text><text x="155" y="388">Soundscape</text>
            <text x="485" y="374"><tspan x="485">Ocean</tspan><tspan x="485" dy="24">environment</tspan></text>
          </g>
        </svg>
        <figcaption>Three interacting domains shape the OBLP research programme.</figcaption>
      </figure>
      <div class="evidence-intro"><p class="eyebrow">{page.data.findings.eyebrow}</p><h2>{page.data.findings.title}</h2><p>{page.data.findings.text}</p></div>
      <p class="evidence-action"><ArrowLink href={withBase('research/')} label={page.data.findings.actionLabel} /></p>
    </div>
  </section>

  <section class="collaboration-section">
    <div class="shell collaboration-grid">
      <div class="collaboration-lead">
        <p class="eyebrow">{page.data.collaboration.eyebrow}</p><h2>{page.data.collaboration.title}</h2>
        <figure class="collaboration-image"><img src={withBase('assets/images/pages/home/Connect.jpg')} width="1920" height="1280" alt="International collaborators advancing shared ocean listening practices" loading="lazy" /></figure>
      </div>
      <div><p class="collaboration-copy">{page.data.collaboration.text}</p><div class="partner-register">{partners.map((partner, index) => <p><span>{String(index + 1).padStart(2, '0')}</span>{partner.data.name}<small>{partner.data.partnerType}</small></p>)}</div><a class="button light" href={withBase(page.data.collaboration.action.href)}>{page.data.collaboration.action.label}</a></div>
    </div>
  </section>
</BaseLayout>
