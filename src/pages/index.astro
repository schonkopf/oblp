---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import DemoNotice from '../components/DemoNotice.astro';
import { stationUrl, surveyUrl, withBase } from '../utils/urls';

const site = await getEntry('site', 'overview');
const stations = (await getCollection('stations', ({ data }) => data.status === 'published')).slice(0, 2);
const surveys = (await getCollection('surveys', ({ data }) => data.status === 'published')).slice(0, 1);
const network = [...stations.map((entry) => ({ entry, kind: 'Station', url: stationUrl(entry.id) })), ...surveys.map((entry) => ({ entry, kind: 'Survey', url: surveyUrl(entry.id) }))];
---
<BaseLayout title="Home" description="The Ocean Biodiversity Listening Project connects acoustic observations across marine ecosystems.">
  <section class="hero hero-dark">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Ocean Biodiversity Listening Project</p>
        <h1>Listening to marine ecosystems across space and time.</h1>
        <p class="lede">{site?.data.overview}</p>
        <div class="button-row"><a class="button light" href={withBase('explore/')}>Explore the network</a><a class="button ghost" href={withBase('about/')}>Collaborate with us</a></div>
      </div>
      <div class="ocean-orbit" aria-label="A conceptual diagram of connected listening stations">
        <span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three"></span>
        <span class="pulse p1"></span><span class="pulse p2"></span><span class="pulse p3"></span><strong>OBLP</strong>
      </div>
    </div>
  </section>

  <section class="section shell why-grid">
    <div><p class="eyebrow">Why listen to the ocean?</p><h2>Sound carries evidence of life.</h2></div>
    <div class="large-copy"><p>Marine soundscapes bring together biological activity, physical processes, and human presence. Listening can complement visual surveys and extend observation through darkness, depth, and changing seasons.</p><p>OBLP’s role is to connect those observations without separating them from their ecological context, methods, or uncertainty.</p></div>
  </section>

  <section class="section section-tint">
    <div class="shell">
      <div class="section-heading split-heading"><div><p class="eyebrow">Listening network</p><h2>One ocean, many windows.</h2></div><p>Select a record to preview the ways fixed stations and spatial surveys connect across the demonstration network.</p></div>
      <DemoNotice />
      <div class="network-preview">
        <div class="network-stage" aria-hidden="true"><svg viewBox="0 0 700 390"><path class="map-shape" d="M38 88c84-70 150-38 212 4 48 33 75 16 129-2 86-29 174-10 277 56l-19 188H56z"/><path class="route" d="M115 255 C240 112 390 302 584 148"/>{network.map((_, i) => <circle class={`node node-${i + 1}`} cx={[115, 349, 584][i]} cy={[255, 207, 148][i]} r="11" />)}</svg></div>
        <div class="network-list" role="list">
          {network.map(({ entry, kind, url }, i) => <article class="network-item" role="listitem"><span>0{i + 1}</span><div><p class="card-type">{kind}</p><h3>{entry.data.title}</h3><p>{entry.data.summary}</p><ArrowLink href={url} label={`View ${kind.toLowerCase()}`} /></div></article>)}
        </div>
      </div>
      <p class="section-action"><ArrowLink href={withBase('explore/')} label="Open the geographic directory" /></p>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading"><p class="eyebrow">Analysis pipeline</p><h2>From ocean signal to shared insight.</h2></div>
    <ol class="pipeline">
      <li><span>01</span><h3>Observe</h3><p>Collect acoustic and contextual observations with documented protocols.</p></li>
      <li><span>02</span><h3>Prepare</h3><p>Standardize metadata, quality checks, and comparable analysis windows.</p></li>
      <li><span>03</span><h3>Interpret</h3><p>Relate patterns to habitats, seasons, and complementary evidence.</p></li>
      <li><span>04</span><h3>Share</h3><p>Publish methods, data products, and evidence with clear provenance.</p></li>
    </ol>
  </section>

  <section class="collaboration-band"><div class="shell"><p class="eyebrow">International collaboration</p><h2>The ocean connects every listening point.</h2><p>Bring a place, dataset, method, or question to a research network designed for exchange across borders and disciplines.</p><a class="button light" href={withBase('about/#collaborate')}>Explore ways to collaborate</a></div></section>
</BaseLayout>
