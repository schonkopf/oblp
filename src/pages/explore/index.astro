---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ObservationHistory from '../../components/ObservationHistory.astro';
import { stationUrl, surveyUrl, withBase } from '../../utils/urls';

const stations = await getCollection('stations', ({ data }) => data.status === 'published' && !data.demo);
const surveys = await getCollection('surveys', ({ data }) => data.status === 'published' && !data.demo);
const regions = new Map((await getCollection('regions')).map((region) => [region.id, region.data.title]));
const historyObservations = [
  ...stations.filter(({ data }) => data.monitoringSince).map(({ id, data }) => ({ id, title: data.title, kind: 'station' as const, region: regions.get(data.region.id) ?? 'Not specified', startDate: data.monitoringSince!, url: stationUrl(id), depthM: data.depthM })),
  ...surveys.filter(({ data }) => data.startDate ?? data.monitoringSince).map(({ id, data }) => ({ id, title: data.title, kind: 'survey' as const, region: regions.get(data.region.id) ?? 'Not specified', startDate: (data.startDate ?? data.monitoringSince)!, url: surveyUrl(id), depthRangeM: data.depthRangeM })),
];
const formatRecordType = (value: string) => {
  const labels: Record<string, string> = {
    'long-term-station': 'Long-term monitoring station',
    'short-term-station': 'Short-term monitoring station',
    'spatial-survey': 'Spatial survey',
    'temporal-survey': 'Temporal survey',
    'experimental-survey': 'Experimental survey',
  };
  return labels[value] ?? value;
};
const year = (date: Date) => date.getUTCFullYear();
const stationPeriod = (data: CollectionEntry<'stations'>['data']) => data.monitoringPeriod
  ?? (data.monitoringSince ? `${year(data.monitoringSince)}–present` : undefined);
const surveyPeriod = (data: CollectionEntry<'surveys'>['data']) => data.period
  ?? (data.startDate ? `${year(data.startDate)}${data.endDate ? `–${year(data.endDate)}` : ''}` : undefined);
const records = [
  ...stations.map((entry) => {
    const coordinates = entry.data.coordinates ? [entry.data.coordinates.longitude, entry.data.coordinates.latitude] : null;
    const pointKind = entry.data.recordType === 'short-term-station' ? 'short-term-station' : 'long-term-station';
    return { id: entry.id, title: entry.data.title, summary: entry.data.summary, kind: 'station', recordType: entry.data.recordType, recordLabel: formatRecordType(entry.data.recordType), period: stationPeriod(entry.data), observations: entry.data.observationTypes, ecosystem: entry.data.ecosystem ?? entry.data.habitat ?? 'Not specified', region: regions.get(entry.data.region.id) ?? 'Not specified', url: stationUrl(entry.id), mapPoints: coordinates ? [{ kind: pointKind, coordinates }] : [], mapArea: null };
  }),
  ...surveys.map((entry) => {
    const observationSites = entry.data.observationSites
      .filter((site) => site.coordinates)
      .map((site) => ({ id: site.id, name: site.name, coordinates: [site.coordinates!.longitude, site.coordinates!.latitude], depthM: site.depthM, observedAt: site.observedAt?.toISOString() }));
    const mapPoints = observationSites.map((site) => ({ kind: 'short-term-station', coordinates: site.coordinates, site }));
    const mapArea = entry.data.polygon
      ? { kind: 'polygon', coordinates: entry.data.polygon }
      : entry.data.mapExtent
        ? { kind: 'extent', bounds: entry.data.mapExtent }
        : null;
    return { id: entry.id, title: entry.data.title, summary: entry.data.summary, kind: 'survey', recordType: entry.data.recordType, recordLabel: formatRecordType(entry.data.recordType), period: surveyPeriod(entry.data), observations: entry.data.observationTypes, ecosystem: entry.data.ecosystem ?? 'Not specified', region: regions.get(entry.data.region.id) ?? 'Not specified', url: surveyUrl(entry.id), mapPoints, mapArea };
  }),
];
const ecosystems = [...new Set(records.map((item) => item.ecosystem))];
const regionNames = [...new Set(records.map((item) => item.region))];
const formatObservation = (value: string) => value === 'eDNA' ? value : value.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const page = await getEntry('pages', 'explore');
if (!page || page.data.pageType !== 'explore') throw new Error('Missing or invalid pages/explore content entry.');
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <Fragment slot="head"><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" /></Fragment>
  <section class="explore-hero">
    <div class="shell explore-hero__layout">
      <div><p class="eyebrow">{page.data.eyebrow}</p><h1>{page.data.heroTitle}</h1></div>
      <figure class="explore-hero__image">
        <img src={withBase(page.data.heroImage.src)} alt={page.data.heroImage.alt} width="2048" height="1365" fetchpriority="high" />
        {(page.data.heroImage.caption || page.data.heroImage.credit) && <figcaption>{page.data.heroImage.caption}{page.data.heroImage.caption && page.data.heroImage.credit && ' '}{page.data.heroImage.credit && <span>Credit: {page.data.heroImage.credit}</span>}</figcaption>}
      </figure>
    </div>
  </section>
  {historyObservations.length > 0 && <ObservationHistory observations={historyObservations} />}
  <section class="listing shell explorer" data-explorer>
    <h2 class="visually-hidden">Observation directory</h2>
    <div id="network-map" class="map" aria-label="Map of monitoring stations and survey observation locations"></div>
    <div class="explore-controls" aria-label="Filter observation records">
      <label class="search-field"><span>Search locations</span><input type="search" name="query" placeholder="Search by title, place, or method" /></label>
      <label><span>Ecosystem</span><select name="ecosystem"><option value="">All ecosystems</option>{ecosystems.map((value) => <option value={value}>{value}</option>)}</select></label>
      <label><span>Region</span><select name="region"><option value="">All regions</option>{regionNames.map((value) => <option value={value}>{value}</option>)}</select></label>
      <button class="reset-button" type="button">Reset</button>
    </div>
    <p class="results-status" aria-live="polite">Showing {records.length} records</p>
    <div class="location-list">
      {records.map((record) => <article class="location-card" data-record={JSON.stringify(record)}>
        <div class="location-meta"><span>{record.kind === 'station' ? '●' : '▰'} {record.recordLabel}</span><span>{record.region}</span></div>
        <h2><a href={record.url}>{record.title}</a></h2><p>{record.summary}</p>
        <ul class="mini-tags">{record.observations.map((value) => <li>{formatObservation(value)}</li>)}</ul>
      </article>)}
      <p class="empty-state no-results" hidden>No records match these filters. Try broadening your search.</p>
    </div>
  </section>
  <script is:inline define:vars={{ records, base: withBase() }}>
    const explorer = document.querySelector('[data-explorer]');
    const cards = [...explorer.querySelectorAll('[data-record]')];
    const status = explorer.querySelector('.results-status');
    const noResults = explorer.querySelector('.no-results');
    let map;
    let mappingSurveyLayerGroup;
    let pointLayerGroup;
    let basemaps;
    let habitatLayers;
    let activeBasemap = 'map';
    let visibleRecords = records;
    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
    function initMap() {
      if (!window.L) return;
      map = L.map('network-map', { scrollWheelZoom: true }).setView([43, -54], 3);
      map.createPane('basemapPane');
      map.getPane('basemapPane').style.zIndex = 200;
      map.createPane('habitatPane');
      map.getPane('habitatPane').style.zIndex = 300;
      // Keep point interaction priority independent of the order in which records render.
      // These marker panes sit above Leaflet's default overlay pane used by survey areas.
      map.createPane('surveyPointPane');
      map.getPane('surveyPointPane').style.zIndex = 410;
      map.createPane('stationPane');
      map.getPane('stationPane').style.zIndex = 430;
      map.createPane('clusterPane');
      map.getPane('clusterPane').style.zIndex = 450;
      const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        pane: 'basemapPane',
        attribution: '&copy; OpenStreetMap contributors',
      });
      const satelliteLayer = L.tileLayer('https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg', {
        maxNativeZoom: 14,
        maxZoom: 18,
        pane: 'basemapPane',
        attribution: '<a href="https://s2maps.eu">Sentinel-2 cloudless</a> by <a href="https://eox.at">EOX IT Services GmbH</a> (Contains modified Copernicus Sentinel data 2020)',
      });
      basemaps = { map: osmLayer, satellite: satelliteLayer };
      basemaps[activeBasemap].addTo(map);
      addBasemapControl();
      const coralAtlasAttribution = 'Habitat maps &copy; <a href="https://allencoralatlas.org/">Allen Coral Atlas Partnership and Arizona State University</a> (CC BY 4.0)';
      const coralAtlasOptions = {
        version: '2.0.0',
        crs: L.CRS.EPSG3857,
        format: 'image/png',
        transparent: true,
        // This generic style is browser-verified; replace it only when the
        // Atlas's official categorical habitat style has been verified.
        styles: 'polygon',
        opacity: 0.72,
        pane: 'habitatPane',
        attribution: coralAtlasAttribution,
      };
      habitatLayers = {
        benthic: L.tileLayer.wms('https://allencoralatlas.org/geoserver/ows', { ...coralAtlasOptions, layers: 'coral-atlas:benthic_data_verbose' }),
      };
      addHabitatControl();
      addMapLegend();
      mappingSurveyLayerGroup = L.featureGroup().addTo(map);
      pointLayerGroup = L.featureGroup().addTo(map);
      map.on('zoomend', renderPointObservationLayers);
      updateFilters();
      fitMapToVisibleRecords();
    }
    function addMapLegend() {
      const LegendControl = L.Control.extend({
        options: { position: 'bottomleft' },
        onAdd() {
          const container = L.DomUtil.create('div', 'map-legend');
          container.setAttribute('aria-label', 'Map symbols');
          container.innerHTML = '<strong>Map symbols</strong><span><i class="map-legend__long" aria-hidden="true"></i>Long-term station</span><span><i class="map-legend__short" aria-hidden="true"></i>Short-term station</span><span><i class="map-legend__area" aria-hidden="true"></i>Mapping survey</span>';
          L.DomEvent.disableClickPropagation(container);
          L.DomEvent.disableScrollPropagation(container);
          return container;
        },
      });
      new LegendControl().addTo(map);
    }
    function addBasemapControl() {
      const BasemapControl = L.Control.extend({
        options: { position: 'topright' },
        onAdd() {
          const container = L.DomUtil.create('div', 'basemap-switch leaflet-bar');
          container.setAttribute('role', 'group');
          container.setAttribute('aria-label', 'Basemap');
          [['map', 'Map'], ['satellite', 'Satellite']].forEach(([id, label]) => {
            const button = L.DomUtil.create('button', 'basemap-switch__button', container);
            button.type = 'button';
            button.textContent = label;
            button.dataset.basemap = id;
            button.setAttribute('aria-pressed', String(id === activeBasemap));
            L.DomEvent.on(button, 'click', () => selectBasemap(id, container));
          });
          L.DomEvent.disableClickPropagation(container);
          L.DomEvent.disableScrollPropagation(container);
          return container;
        },
      });
      new BasemapControl().addTo(map);
    }
    function addHabitatControl() {
      const HabitatControl = L.Control.extend({
        options: { position: 'topright' },
        onAdd() {
          const container = L.DomUtil.create('div', 'habitat-control leaflet-bar');
          const label = L.DomUtil.create('label', 'habitat-control__option', container);
          const checkbox = L.DomUtil.create('input', '', label);
          checkbox.type = 'checkbox';
          checkbox.dataset.habitat = 'benthic';
          checkbox.disabled = !habitatLayers.benthic;
          const text = L.DomUtil.create('span', '', label);
          text.textContent = 'Reef habitat';
          L.DomEvent.on(checkbox, 'change', () => toggleHabitat('benthic', checkbox.checked));
          L.DomEvent.disableClickPropagation(container);
          L.DomEvent.disableScrollPropagation(container);
          return container;
        },
      });
      new HabitatControl().addTo(map);
    }
    function toggleHabitat(id, enabled) {
      const layer = habitatLayers[id];
      if (!layer) return;
      if (enabled && !map.hasLayer(layer)) layer.addTo(map);
      if (!enabled && map.hasLayer(layer)) map.removeLayer(layer);
    }
    function selectBasemap(nextBasemap, control) {
      if (nextBasemap === activeBasemap || !basemaps[nextBasemap]) return;
      map.removeLayer(basemaps[activeBasemap]);
      basemaps[nextBasemap].addTo(map);
      activeBasemap = nextBasemap;
      control.querySelectorAll('[data-basemap]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.basemap === activeBasemap));
      });
    }
    function popupContent(item) {
      return `<strong>${escapeHtml(item.title)}</strong><br><span>${escapeHtml(item.recordLabel)}</span><p>${escapeHtml(item.summary)}</p><a href="${escapeHtml(item.url)}">View ${escapeHtml(item.kind)} &rarr;</a>`;
    }
    function sitePopupContent(item, site) {
      return `<strong>${escapeHtml(site.name)}</strong><p>Observation site within ${escapeHtml(item.title)}</p><a href="${escapeHtml(item.url)}">View survey &rarr;</a>`;
    }
    function physicalLocations(items = visibleRecords) {
      return items.flatMap((item) => item.mapPoints.map((location) => ({ ...location, item })));
    }
    function coordinatesMatch(left, right) {
      return Math.abs(left[0] - right[0]) < 1e-6 && Math.abs(left[1] - right[1]) < 1e-6;
    }
    function observationsAt(coordinates) {
      return physicalLocations().filter((location) => coordinatesMatch(location.coordinates, coordinates)).map((location) => ({ item: location.item, site: location.site, label: location.site ? 'Survey observation site' : location.item.recordLabel }));
    }
    function colocatedPopupContent(matches) {
      const records = matches.map(({ item, site, label }) => {
        return `<li>${item.period ? `<span>${escapeHtml(item.period)}</span><br>` : ''}<span>${escapeHtml(label)}${site ? ` · ${escapeHtml(site.name)}` : ''}</span><br><strong>${escapeHtml(item.title)}</strong><br><a href="${escapeHtml(item.url)}">View ${escapeHtml(item.kind)}: ${escapeHtml(item.title)} &rarr;</a></li>`;
      }).join('');
      return `<strong>Observation history</strong><ul class="map-observation-history">${records}</ul>`;
    }
    function clusterPopupContent(locations) {
      const entries = locations.map(({ item, site, kind }) => {
        const type = kind === 'long-term-station'
          ? 'Long-term station'
          : `Short-term station${site ? ` · ${escapeHtml(site.name)}` : ''}`;
        return `<li><span>${type}</span><br><strong>${escapeHtml(item.title)}</strong><br><a href="${escapeHtml(item.url)}">View ${escapeHtml(item.kind)} &rarr;</a></li>`;
      }).join('');
      return `<strong>Observation locations</strong><ul class="map-observation-history">${entries}</ul>`;
    }
    function popupAt(coordinates, fallback) {
      const matches = observationsAt(coordinates);
      return matches.length > 1 ? colocatedPopupContent(matches) : fallback;
    }
    function bindObservation(layer, item) {
      layer.bindPopup(popupContent(item));
      layer.bindTooltip(`${item.title} — ${item.recordLabel}`);
      layer.eachLayer?.((child) => bindObservationAccessibility(child, item));
      bindObservationAccessibility(layer, item);
      return layer;
    }
    function bindObservationAccessibility(layer, item) {
      layer.on?.('add', () => {
        const element = layer.getElement?.();
        if (!element) return;
        element.setAttribute('aria-label', `${item.title}, ${item.recordLabel}`);
        if (element.tagName.toLowerCase() === 'path') {
          element.setAttribute('role', 'button');
          element.setAttribute('tabindex', '0');
          element.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              layer.openPopup?.();
            }
          });
        }
      });
    }
    function observationLayer(location) {
      const { item } = location;
      const [longitude, latitude] = location.coordinates;
      if (location.kind === 'long-term-station') {
        const title = `${item.title}, ${item.recordLabel}`;
        const marker = bindObservation(L.marker([latitude, longitude], {
          pane: 'stationPane',
          keyboard: true,
          title,
          icon: L.divIcon({ className: 'long-term-station-icon', html: '<span class="long-term-station-icon__glyph" aria-hidden="true"></span>', iconSize: [18, 18], iconAnchor: [9, 9] }),
        }), item);
        marker.bindPopup(popupAt(location.coordinates, popupContent(item))).on('add', (event) => event.target.getElement()?.setAttribute('aria-label', title));
        return marker;
      }
      if (location.kind === 'short-term-station') {
        const { site } = location;
        const title = site ? `${site.name}, observation site within ${item.title}` : `${item.title}, short-term station`;
        const popup = site ? sitePopupContent(item, site) : popupContent(item);
        const tooltip = site ? `${site.name} — ${item.title}` : `${item.title} — Short-term monitoring station`;
        return bindObservation(L.marker([latitude, longitude], {
          pane: 'surveyPointPane',
          keyboard: true,
          title,
          icon: L.divIcon({ className: 'survey-observation-icon', html: '<span class="survey-observation-icon__glyph" aria-hidden="true"></span>', iconSize: [18, 18], iconAnchor: [9, 9] }),
        }), item).bindPopup(popupAt(location.coordinates, popup)).bindTooltip(tooltip).on('add', (event) => event.target.getElement()?.setAttribute('aria-label', title));
      }
    }
    function mappingSurveyLayer(item) {
      const options = { className: 'mapping-survey-area', color: 'var(--map-survey-outline)', weight: 2, opacity: .8, fillColor: 'var(--map-survey-fill)', fillOpacity: .15 };
      const layer = item.mapArea.kind === 'extent'
        ? L.rectangle([[item.mapArea.bounds.south, item.mapArea.bounds.west], [item.mapArea.bounds.north, item.mapArea.bounds.east]], options)
        : L.polygon(item.mapArea.coordinates.map(([longitude, latitude]) => [latitude, longitude]), options);
      bindObservation(layer, item).bindTooltip(`${item.title} — Spatial survey`);
      layer.on('mouseover', () => layer.setStyle({ weight: 3, fillOpacity: .22 }));
      layer.on('mouseout', () => layer.setStyle({ weight: 2, fillOpacity: .15 }));
      return layer;
    }
    function clusterRadiusForZoom(zoom) {
      if (zoom <= 7) return 72;
      if (zoom <= 10) return 60;
      if (zoom <= 13) return 44;
      if (zoom <= 15) return 28;
      if (zoom <= 17) return 18;
      return 0;
    }
    function clusterLocations(locations, zoom, project) {
      const parent = locations.map((_, index) => index);
      const find = (index) => parent[index] === index ? index : (parent[index] = find(parent[index]));
      const unite = (left, right) => { const leftRoot = find(left); const rightRoot = find(right); if (leftRoot !== rightRoot) parent[rightRoot] = leftRoot; };
      const radius = clusterRadiusForZoom(zoom);
      const points = locations.map((location) => project(location, zoom));
      for (let left = 0; left < points.length; left += 1) {
        for (let right = left + 1; right < points.length; right += 1) {
          if (coordinatesMatch(locations[left].coordinates, locations[right].coordinates) || (radius > 0 && points[left].distanceTo(points[right]) <= radius)) unite(left, right);
        }
      }
      const groups = new Map();
      locations.forEach((location, index) => {
        const root = find(index);
        if (!groups.has(root)) groups.set(root, []);
        groups.get(root).push(location);
      });
      return [...groups.values()];
    }
    function clusterVisible(locations) {
      return clusterLocations(locations, map.getZoom(), (location) => map.latLngToLayerPoint([location.coordinates[1], location.coordinates[0]]));
    }
    function nextSeparatingZoom(locations) {
      const currentZoom = map.getZoom();
      const maximumZoom = map.getMaxZoom();
      for (let zoom = currentZoom + 1; zoom <= maximumZoom; zoom += 1) {
        const groups = clusterLocations(locations, zoom, (location, candidateZoom) => map.project([location.coordinates[1], location.coordinates[0]], candidateZoom));
        if (groups.length > 1) return zoom;
      }
      return null;
    }
    function renderCluster(locations) {
      const latitude = locations.reduce((sum, location) => sum + location.coordinates[1], 0) / locations.length;
      const longitude = locations.reduce((sum, location) => sum + location.coordinates[0], 0) / locations.length;
      const label = `${locations.length} observation locations in this area`;
      const size = Math.min(48, 34 + Math.log2(locations.length) * 4);
      const marker = L.marker([latitude, longitude], {
        pane: 'clusterPane',
        title: label,
        keyboard: true,
        icon: L.divIcon({
          className: 'observation-cluster-icon',
          html: `<span role="img" aria-label="${label}">${locations.length}</span>`,
          iconSize: [size, size],
          iconAnchor: [size / 2, size / 2],
        }),
      });
      marker.bindTooltip(`<strong>${locations.length} observation locations</strong>`);
      marker.on('click', () => {
        const separatingZoom = nextSeparatingZoom(locations);
        if (separatingZoom === null) {
          marker.bindPopup(clusterPopupContent(locations)).openPopup();
          return;
        }
        const bounds = L.latLngBounds(locations.map((location) => [location.coordinates[1], location.coordinates[0]]));
        map.setView(bounds.getCenter(), separatingZoom);
      });
      marker.addTo(pointLayerGroup);
    }
    function renderMappingSurveyLayers() {
      if (!map) return;
      mappingSurveyLayerGroup.clearLayers();
      visibleRecords.filter((item) => item.mapArea).forEach((item) => mappingSurveyLayer(item).addTo(mappingSurveyLayerGroup));
    }
    function renderPointObservationLayers() {
      if (!map) return;
      pointLayerGroup.clearLayers();
      clusterVisible(physicalLocations()).forEach((locations) => {
        if (locations.length > 1) renderCluster(locations);
        else observationLayer(locations[0]).addTo(pointLayerGroup);
      });
    }
    function fitMapToVisibleRecords() {
      const bounds = L.latLngBounds();
      visibleRecords.forEach((item) => {
        item.mapPoints.forEach(({ coordinates: [longitude, latitude] }) => bounds.extend([latitude, longitude]));
        if (item.mapArea?.kind === 'extent') {
          const { west, east, south, north } = item.mapArea.bounds;
          bounds.extend([[south, west], [north, east]]);
        }
        if (item.mapArea?.kind === 'polygon') {
          item.mapArea.coordinates.forEach(([longitude, latitude]) => bounds.extend([latitude, longitude]));
        }
      });
      if (bounds.isValid()) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 7 });
    }
    function updateFilters({ fitMap = false } = {}) {
      const query = explorer.querySelector('[name=query]').value.trim().toLowerCase();
      const ecosystem = explorer.querySelector('[name=ecosystem]').value;
      const region = explorer.querySelector('[name=region]').value;
      visibleRecords = records.filter((item) => (!query || `${item.title} ${item.summary} ${item.region} ${item.ecosystem} ${item.observations.join(' ')}`.toLowerCase().includes(query)) && (!ecosystem || item.ecosystem === ecosystem) && (!region || item.region === region));
      const visibleIds = new Set(visibleRecords.map((item) => item.id));
      cards.forEach((card) => { card.hidden = !visibleIds.has(JSON.parse(card.dataset.record).id); });
      status.textContent = `Showing ${visibleRecords.length} of ${records.length} records`;
      noResults.hidden = visibleRecords.length !== 0;
      if (!map) return;
      renderMappingSurveyLayers();
      renderPointObservationLayers();
      if (fitMap) fitMapToVisibleRecords();
    }
    explorer.querySelector('.explore-controls').addEventListener('input', () => updateFilters({ fitMap: true }));
    explorer.querySelector('.reset-button').addEventListener('click', () => { explorer.querySelectorAll('.explore-controls input, .explore-controls select').forEach((input) => input.value = ''); updateFilters({ fitMap: true }); });
    const leaflet = document.createElement('script'); leaflet.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'; leaflet.crossOrigin = 'anonymous'; leaflet.onload = initMap; document.head.append(leaflet);
  </script>
</BaseLayout>
