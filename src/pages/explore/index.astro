---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ObservationHistory from '../../components/ObservationHistory.astro';
import { stationUrl, surveyUrl, withBase } from '../../utils/urls';

const stations = await getCollection('stations', ({ data }) => data.status === 'published' && !data.demo);
const surveys = await getCollection('surveys', ({ data }) => data.status === 'published' && !data.demo);
const regions = new Map((await getCollection('regions')).map((region) => [region.id, region.data.title]));
const historyObservations = [
  ...stations.filter(({ data }) => data.monitoringSince).map(({ id, data }) => ({ id, title: data.title, kind: 'station' as const, region: regions.get(data.region.id) ?? 'Not specified', startDate: data.monitoringSince!, url: stationUrl(id), depthM: data.depthM })),
  ...surveys.filter(({ data }) => data.startDate ?? data.monitoringSince).map(({ id, data }) => ({ id, title: data.title, kind: 'survey' as const, region: regions.get(data.region.id) ?? 'Not specified', startDate: (data.startDate ?? data.monitoringSince)!, url: surveyUrl(id), depthRangeM: data.depthRangeM })),
];
const formatRecordType = (value: string) => {
  const labels: Record<string, string> = {
    'long-term-station': 'Long-term monitoring station',
    'short-term-station': 'Short-term monitoring station',
    'spatial-survey': 'Spatial survey',
    'temporal-survey': 'Temporal survey',
    'experimental-survey': 'Experimental survey',
  };
  return labels[value] ?? value;
};
const polygonCenter = (polygon: Array<[number, number]>): [number, number] => {
  let twiceArea = 0;
  let longitudeSum = 0;
  let latitudeSum = 0;
  polygon.forEach(([longitude, latitude], index) => {
    const [nextLongitude, nextLatitude] = polygon[(index + 1) % polygon.length];
    const cross = longitude * nextLatitude - nextLongitude * latitude;
    twiceArea += cross;
    longitudeSum += (longitude + nextLongitude) * cross;
    latitudeSum += (latitude + nextLatitude) * cross;
  });
  if (Math.abs(twiceArea) > Number.EPSILON) {
    return [longitudeSum / (3 * twiceArea), latitudeSum / (3 * twiceArea)];
  }
  const longitudes = polygon.map(([longitude]) => longitude);
  const latitudes = polygon.map(([, latitude]) => latitude);
  return [(Math.min(...longitudes) + Math.max(...longitudes)) / 2, (Math.min(...latitudes) + Math.max(...latitudes)) / 2];
};
const year = (date: Date) => date.getUTCFullYear();
const stationPeriod = (data: CollectionEntry<'stations'>['data']) => data.monitoringPeriod
  ?? (data.monitoringSince ? `${year(data.monitoringSince)}–present` : undefined);
const surveyPeriod = (data: CollectionEntry<'surveys'>['data']) => data.period
  ?? (data.startDate ? `${year(data.startDate)}${data.endDate ? `–${year(data.endDate)}` : ''}` : undefined);
const records = [
  ...stations.map((entry) => ({ id: entry.id, title: entry.data.title, summary: entry.data.summary, kind: 'station', recordType: entry.data.recordType, recordLabel: formatRecordType(entry.data.recordType), period: stationPeriod(entry.data), observations: entry.data.observationTypes, ecosystem: entry.data.ecosystem ?? entry.data.habitat ?? 'Not specified', region: regions.get(entry.data.region.id) ?? 'Not specified', url: stationUrl(entry.id), geometry: entry.data.coordinates ? { type: 'Point', coordinates: [entry.data.coordinates.longitude, entry.data.coordinates.latitude] } : null, clusterLocation: entry.data.coordinates ? [entry.data.coordinates.longitude, entry.data.coordinates.latitude] : null })),
  ...surveys.map((entry) => {
    const extent = entry.data.mapExtent;
    const extentPolygon = extent ? [[extent.west, extent.south], [extent.east, extent.south], [extent.east, extent.north], [extent.west, extent.north], [extent.west, extent.south]] : null;
    const polygon = entry.data.polygon ? [...entry.data.polygon, entry.data.polygon[0]] : extentPolygon;
    const observationSites = entry.data.observationSites.map((site) => ({ id: site.id, name: site.name, coordinates: [site.coordinates.longitude, site.coordinates.latitude], observedAt: site.observedAt?.toISOString() }));
    const clusterLocation = observationSites.length
      ? [observationSites.reduce((sum, site) => sum + site.coordinates[0], 0) / observationSites.length, observationSites.reduce((sum, site) => sum + site.coordinates[1], 0) / observationSites.length]
      : entry.data.polygon ? polygonCenter(entry.data.polygon)
      : extent ? [(extent.west + extent.east) / 2, (extent.south + extent.north) / 2] : null;
    const geometry = observationSites.length
      ? { type: 'MultiPoint', coordinates: observationSites.map((site) => site.coordinates) }
      : polygon ? { type: 'Polygon', coordinates: [polygon] } : null;
    return { id: entry.id, title: entry.data.title, summary: entry.data.summary, kind: 'survey', recordType: entry.data.recordType, recordLabel: formatRecordType(entry.data.recordType), period: surveyPeriod(entry.data), observations: entry.data.observationTypes, ecosystem: entry.data.ecosystem ?? 'Not specified', region: regions.get(entry.data.region.id) ?? 'Not specified', url: surveyUrl(entry.id), geometry, clusterLocation, observationSites };
  }),
];
const ecosystems = [...new Set(records.map((item) => item.ecosystem))];
const regionNames = [...new Set(records.map((item) => item.region))];
const formatObservation = (value: string) => value === 'eDNA' ? value : value.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const page = await getEntry('pages', 'explore');
if (!page || page.data.pageType !== 'explore') throw new Error('Missing or invalid pages/explore content entry.');
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <Fragment slot="head"><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" /></Fragment>
  <section class="explore-hero">
    <div class="shell explore-hero__layout">
      <div><p class="eyebrow">{page.data.eyebrow}</p><h1>{page.data.heroTitle}</h1></div>
      <figure class="explore-hero__image">
        <img src={withBase(page.data.heroImage.src)} alt={page.data.heroImage.alt} width="2048" height="1365" fetchpriority="high" />
        {(page.data.heroImage.caption || page.data.heroImage.credit) && <figcaption>{page.data.heroImage.caption}{page.data.heroImage.caption && page.data.heroImage.credit && ' '}{page.data.heroImage.credit && <span>Credit: {page.data.heroImage.credit}</span>}</figcaption>}
      </figure>
    </div>
  </section>
  {historyObservations.length > 0 && <ObservationHistory observations={historyObservations} />}
  <section class="listing shell explorer" data-explorer>
    <h2 class="visually-hidden">Observation directory</h2>
    <div id="network-map" class="map" aria-label="Map of monitoring stations and survey observation locations"></div>
    <div class="explore-controls" aria-label="Filter observation records">
      <label class="search-field"><span>Search locations</span><input type="search" name="query" placeholder="Search by title, place, or method" /></label>
      <label><span>Ecosystem</span><select name="ecosystem"><option value="">All ecosystems</option>{ecosystems.map((value) => <option value={value}>{value}</option>)}</select></label>
      <label><span>Region</span><select name="region"><option value="">All regions</option>{regionNames.map((value) => <option value={value}>{value}</option>)}</select></label>
      <button class="reset-button" type="button">Reset</button>
    </div>
    <p class="results-status" aria-live="polite">Showing {records.length} records</p>
    <div class="location-list">
      {records.map((record) => <article class="location-card" data-record={JSON.stringify(record)}>
        <div class="location-meta"><span>{record.kind === 'station' ? '●' : '▰'} {record.recordLabel}</span><span>{record.region}</span></div>
        <h2><a href={record.url}>{record.title}</a></h2><p>{record.summary}</p>
        <ul class="mini-tags">{record.observations.map((value) => <li>{formatObservation(value)}</li>)}</ul>
      </article>)}
      <p class="empty-state no-results" hidden>No records match these filters. Try broadening your search.</p>
    </div>
  </section>
  <script is:inline define:vars={{ records, base: withBase() }}>
    const explorer = document.querySelector('[data-explorer]');
    const cards = [...explorer.querySelectorAll('[data-record]')];
    const status = explorer.querySelector('.results-status');
    const noResults = explorer.querySelector('.no-results');
    let map;
    let layerGroup;
    let basemaps;
    let activeBasemap = 'map';
    let visibleRecords = records;
    const closeZoom = 11;
    const clusterRadius = 72;
    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
    function initMap() {
      if (!window.L) return;
      map = L.map('network-map', { scrollWheelZoom: true }).setView([43, -54], 3);
      const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; OpenStreetMap contributors',
      });
      const satelliteLayer = L.tileLayer('https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg', {
        maxNativeZoom: 14,
        maxZoom: 18,
        attribution: '<a href="https://s2maps.eu">Sentinel-2 cloudless</a> by <a href="https://eox.at">EOX IT Services GmbH</a> (Contains modified Copernicus Sentinel data 2020)',
      });
      basemaps = { map: osmLayer, satellite: satelliteLayer };
      basemaps[activeBasemap].addTo(map);
      addBasemapControl();
      layerGroup = L.featureGroup().addTo(map);
      map.on('zoomend', renderMap);
      update({ fitMap: true });
    }
    function addBasemapControl() {
      const BasemapControl = L.Control.extend({
        options: { position: 'topright' },
        onAdd() {
          const container = L.DomUtil.create('div', 'basemap-switch leaflet-bar');
          container.setAttribute('role', 'group');
          container.setAttribute('aria-label', 'Basemap');
          [['map', 'Map'], ['satellite', 'Satellite']].forEach(([id, label]) => {
            const button = L.DomUtil.create('button', 'basemap-switch__button', container);
            button.type = 'button';
            button.textContent = label;
            button.dataset.basemap = id;
            button.setAttribute('aria-pressed', String(id === activeBasemap));
            L.DomEvent.on(button, 'click', () => selectBasemap(id, container));
          });
          L.DomEvent.disableClickPropagation(container);
          L.DomEvent.disableScrollPropagation(container);
          return container;
        },
      });
      new BasemapControl().addTo(map);
    }
    function selectBasemap(nextBasemap, control) {
      if (nextBasemap === activeBasemap || !basemaps[nextBasemap]) return;
      map.removeLayer(basemaps[activeBasemap]);
      basemaps[nextBasemap].addTo(map);
      activeBasemap = nextBasemap;
      control.querySelectorAll('[data-basemap]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.basemap === activeBasemap));
      });
    }
    function popupContent(item) {
      return `<strong>${escapeHtml(item.title)}</strong><br><span>${escapeHtml(item.recordLabel)}</span><p>${escapeHtml(item.summary)}</p><a href="${escapeHtml(item.url)}">View ${escapeHtml(item.kind)} &rarr;</a>`;
    }
    function sitePopupContent(item, site) {
      return `<strong>${escapeHtml(site.name)}</strong><br><span>Observation site within ${escapeHtml(item.title)}</span><p>${escapeHtml(item.recordLabel)}<br>${escapeHtml(item.region)}</p><a href="${escapeHtml(item.url)}">View survey &rarr;</a>`;
    }
    function observationsAt(coordinates) {
      const [longitude, latitude] = coordinates;
      const matches = [];
      visibleRecords.forEach((item) => {
        if (item.kind === 'station' && item.clusterLocation?.[0] === longitude && item.clusterLocation?.[1] === latitude) {
          matches.push({ item, label: item.recordLabel });
        }
        item.observationSites?.forEach((site) => {
          if (site.coordinates[0] === longitude && site.coordinates[1] === latitude) {
            matches.push({ item, site, label: 'Survey observation site' });
          }
        });
      });
      return matches;
    }
    function colocatedPopupContent(matches) {
      const records = matches.map(({ item, site, label }) => `<li>${item.period ? `<span>${escapeHtml(item.period)}</span><br>` : ''}<span>${escapeHtml(label)}${site ? ` · ${escapeHtml(site.name)}` : ''}</span><br><strong>${escapeHtml(item.title)}</strong><br><a href="${escapeHtml(item.url)}">View ${escapeHtml(item.kind)}: ${escapeHtml(item.title)} &rarr;</a></li>`).join('');
      return `<strong>Observation history</strong><ul class="map-observation-history">${records}</ul>`;
    }
    function popupAt(coordinates, fallback) {
      const matches = observationsAt(coordinates);
      return matches.length > 1 ? colocatedPopupContent(matches) : fallback;
    }
    function bindObservation(layer, item) {
      layer.bindPopup(popupContent(item));
      layer.bindTooltip(`${item.title} — ${item.recordLabel}`);
      layer.eachLayer?.((child) => bindObservationAccessibility(child, item));
      bindObservationAccessibility(layer, item);
      return layer;
    }
    function bindObservationAccessibility(layer, item) {
      layer.on?.('add', () => {
        const element = layer.getElement?.();
        if (element) element.setAttribute('aria-label', `${item.title}, ${item.recordLabel}`);
      });
    }
    function observationLayer(item, compact = false) {
      const [longitude, latitude] = item.clusterLocation;
      if (item.kind === 'station') {
        const marker = bindObservation(L.circleMarker([latitude, longitude], {
          radius: compact ? 7 : 9,
          color: 'var(--map-marker-halo)',
          weight: 3,
          fillColor: 'var(--map-station)',
          fillOpacity: 1,
        }), item);
        marker.bindPopup(popupAt(item.clusterLocation, popupContent(item)));
        return marker;
      }
      if (compact) {
        return bindObservation(L.marker([latitude, longitude], {
          title: `${item.title}, ${item.recordLabel}`,
          icon: L.divIcon({ className: 'survey-location-icon', html: '<span aria-hidden="true"></span>', iconSize: [22, 22], iconAnchor: [11, 11] }),
        }), item);
      }
      if (item.observationSites?.length) {
        return L.featureGroup(item.observationSites.map((site) => {
          const [siteLongitude, siteLatitude] = site.coordinates;
          const marker = L.marker([siteLatitude, siteLongitude], {
            keyboard: true,
            title: `${site.name}, observation site within ${item.title}`,
            icon: L.divIcon({ className: 'survey-observation-icon', html: '<span aria-hidden="true"></span>', iconSize: [18, 18], iconAnchor: [9, 9] }),
          });
          marker.bindPopup(popupAt(site.coordinates, sitePopupContent(item, site)));
          marker.bindTooltip(`${site.name} — ${item.title}`);
          marker.on('add', () => marker.getElement()?.setAttribute('aria-label', `${site.name}, observation site within ${item.title}`));
          return marker;
        }));
      }
      return bindObservation(L.geoJSON({ type: 'Feature', properties: item, geometry: item.geometry }, {
        style: { color: 'var(--map-survey-outline)', weight: 4, opacity: 1, fillColor: 'var(--map-survey-fill)', fillOpacity: .22 },
      }), item);
    }
    function clusterVisible(items) {
      const located = items.filter((item) => item.clusterLocation);
      const parent = located.map((_, index) => index);
      const find = (index) => parent[index] === index ? index : (parent[index] = find(parent[index]));
      const unite = (left, right) => { const leftRoot = find(left); const rightRoot = find(right); if (leftRoot !== rightRoot) parent[rightRoot] = leftRoot; };
      const points = located.map((item) => map.latLngToLayerPoint([item.clusterLocation[1], item.clusterLocation[0]]));
      for (let left = 0; left < points.length; left += 1) {
        for (let right = left + 1; right < points.length; right += 1) {
          if (points[left].distanceTo(points[right]) <= clusterRadius) unite(left, right);
        }
      }
      const groups = new Map();
      located.forEach((item, index) => {
        const root = find(index);
        if (!groups.has(root)) groups.set(root, []);
        groups.get(root).push(item);
      });
      return [...groups.values()];
    }
    function renderCluster(items) {
      const latitude = items.reduce((sum, item) => sum + item.clusterLocation[1], 0) / items.length;
      const longitude = items.reduce((sum, item) => sum + item.clusterLocation[0], 0) / items.length;
      const stations = items.filter((item) => item.kind === 'station').length;
      const surveys = items.length - stations;
      const label = `${items.length} observation records in this area`;
      const size = Math.min(48, 34 + Math.log2(items.length) * 4);
      const marker = L.marker([latitude, longitude], {
        title: label,
        keyboard: true,
        icon: L.divIcon({
          className: 'observation-cluster-icon',
          html: `<span role="img" aria-label="${label}">${items.length}</span>`,
          iconSize: [size, size],
          iconAnchor: [size / 2, size / 2],
        }),
      });
      marker.bindTooltip(`<strong>${items.length} observations</strong><br>${stations} ${stations === 1 ? 'station' : 'stations'} · ${surveys} ${surveys === 1 ? 'survey' : 'surveys'}`);
      marker.on('click', () => {
        const bounds = L.latLngBounds(items.map((item) => [item.clusterLocation[1], item.clusterLocation[0]]));
        if (bounds.getNorthEast().equals(bounds.getSouthWest())) map.setView(bounds.getCenter(), Math.min(closeZoom, map.getZoom() + 2));
        else map.fitBounds(bounds, { padding: [45, 45], maxZoom: closeZoom });
      });
      marker.addTo(layerGroup);
    }
    function renderMap() {
      if (!map) return;
      layerGroup.clearLayers();
      const located = visibleRecords.filter((item) => item.clusterLocation && item.geometry);
      if (map.getZoom() >= closeZoom) {
        located.forEach((item) => observationLayer(item).addTo(layerGroup));
        return;
      }
      clusterVisible(located).forEach((items) => {
        if (items.length > 1) renderCluster(items);
        else observationLayer(items[0], true).addTo(layerGroup);
      });
    }
    function fitVisibleRecords() {
      const layers = visibleRecords.filter((item) => item.geometry && item.clusterLocation).map((item) => L.geoJSON({ type: 'Feature', properties: item, geometry: item.geometry }));
      if (!layers.length) return;
      const bounds = L.featureGroup(layers).getBounds();
      if (bounds.isValid()) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 7 });
    }
    function update({ fitMap = false } = {}) {
      const query = explorer.querySelector('[name=query]').value.trim().toLowerCase();
      const ecosystem = explorer.querySelector('[name=ecosystem]').value;
      const region = explorer.querySelector('[name=region]').value;
      visibleRecords = records.filter((item) => (!query || `${item.title} ${item.summary} ${item.region} ${item.ecosystem} ${item.observations.join(' ')}`.toLowerCase().includes(query)) && (!ecosystem || item.ecosystem === ecosystem) && (!region || item.region === region));
      const visibleIds = new Set(visibleRecords.map((item) => item.id));
      cards.forEach((card) => { card.hidden = !visibleIds.has(JSON.parse(card.dataset.record).id); });
      status.textContent = `Showing ${visibleRecords.length} of ${records.length} records`;
      noResults.hidden = visibleRecords.length !== 0;
      if (!map) return;
      renderMap();
      if (fitMap) fitVisibleRecords();
    }
    explorer.addEventListener('input', () => update({ fitMap: true }));
    explorer.querySelector('.reset-button').addEventListener('click', () => { explorer.querySelectorAll('input, select').forEach((input) => input.value = ''); update({ fitMap: true }); });
    const leaflet = document.createElement('script'); leaflet.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'; leaflet.crossOrigin = 'anonymous'; leaflet.onload = initMap; document.head.append(leaflet);
  </script>
</BaseLayout>
